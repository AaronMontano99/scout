# Copy to .env.local and fill in real values. Never commit .env.local —
# see docs/SECURITY.md. Variable NAMES only below; no real secrets.
#
# Local-first mode (docs/LOCAL_MODE.md) needs NONE of this to run —
# `npm install && npm run dev` works with zero .env.local file at all.
# Your data lives in a local SQLite file (data/scout.db), not a hosted
# database.

# --- AI provider — entirely optional. If ANTHROPIC_API_KEY is unset,
# Scout runs with no AI features and no live research provider; every
# account is entered manually. Model names are config, never hardcoded
# in business logic — see docs/AI_ARCHITECTURE.md. ---
AI_MODEL_EXTRACTION=
AI_MODEL_CLASSIFICATION=
AI_MODEL_REASONING=
AI_MODEL_SUMMARY=
AI_MODEL_EMBEDDING=
ANTHROPIC_API_KEY=
