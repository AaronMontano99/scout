# Copy to .env.local and fill in real values. Never commit .env.local —
# see docs/SECURITY.md. Variable NAMES only below; no real secrets.
#
# Local-first mode (docs/LOCAL_MODE.md) needs NONE of this to run —
# `npm install && npm run dev` works with zero .env.local file at all.
# Your data lives in a local SQLite file (data/scout.db), not a hosted
# database.

# --- AI provider — entirely optional, and local: Scout talks to a
# locally-running Ollama server (https://ollama.com), never a hosted
# API, for two things — Call-Ready Brief summaries and clean call
# notes (see src/ai/providers/ollama-provider.ts). If Ollama isn't
# running, those two steps just quietly do nothing; nothing else in
# Scout needs this. Model names default to "llama3.2" below — override
# per-workload if you've pulled a different model. Model names are
# config, never hardcoded in business logic — see docs/AI_ARCHITECTURE.md. ---
AI_MODEL_EXTRACTION=llama3.2
AI_MODEL_CLASSIFICATION=llama3.2
AI_MODEL_REASONING=llama3.2
AI_MODEL_SUMMARY=llama3.2
AI_MODEL_EMBEDDING=llama3.2
OLLAMA_HOST=http://localhost:11434

# Unused by anything in Local Mode today — kept as a future extension
# point if a hosted AI provider is ever wired up alongside Ollama.
ANTHROPIC_API_KEY=
