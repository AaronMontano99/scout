# Copy to .env.local and fill in real values. Never commit .env.local —
# Variable NAMES only below; no real secrets.
#
# Scout needs NONE of this to run: `npm install && npm run dev` works
# with no .env.local at all. The AI runs through the Claude Code CLI on
# your Claude account; data lives in data/scout.db.

# Not used. Scout deliberately strips this from the Claude CLI's
# environment so it always runs on your membership, never API billing.
ANTHROPIC_API_KEY=

# Optional: path to the Claude Code binary if it isn't in ~/.local/bin or on PATH.
# SCOUT_CLAUDE_BIN=/path/to/claude
